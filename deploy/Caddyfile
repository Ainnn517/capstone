# Barangay Reporting System - web server for the production copy in /srv/barangay/app.
# Only reachable from this computer; the Cloudflare tunnel forwards public traffic here.
{
	admin localhost:2019
	servers {
		# The tunnel (cloudflared) connects from 127.0.0.1: keep the X-Forwarded-For and
		# X-Forwarded-Proto it passes on, so the app sees the visitor's real IP and https.
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

http://:8002 {
	bind 127.0.0.1

	root * /srv/barangay/app/public

	# Never serve hidden files such as .htaccess.
	@hidden path */.*
	respond @hidden 404

	request_body {
		max_size 32MB
	}

	header -Server
	encode gzip

	php_fastcgi unix//run/php/barangay.sock
	file_server
}
