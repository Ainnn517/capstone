APP_NAME="Barangay Reporting System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
GOOGLE_MAPS_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barangay_reporting
DB_USERNAME=your_mysql_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

PILOT_ADMIN_USERNAME=
PILOT_ADMIN_NAME="Pilot Administrator"
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_PASSWORD=
PILOT_RESIDENT_USERNAME=
PILOT_RESIDENT_NAME="Pilot Resident"
PILOT_RESIDENT_EMAIL=
PILOT_RESIDENT_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The log mailer records messages locally and does not send email to inboxes.
EMAIL_VERIFICATION_REQUIRED=true
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional AI-assisted triage (category suggestions and duplicate detection).
# Leave ANTHROPIC_API_KEY empty to use the built-in keyword rules only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
TRIAGE_AI_EFFORT=low
TRIAGE_AI_TIMEOUT=15

# Production: set APP_ENV=production, APP_DEBUG=false, the real https APP_URL, and
# SESSION_SECURE_COOKIE=true. If the host puts a proxy/load balancer in front of PHP,
# list its IP(s) or CIDR range(s) here (comma separated), or * when the host requires it.
TRUSTED_PROXIES=
